# SignalPulse root environment reference.
# Copy to backend/.env for the backend to pick it up.

APP_NAME=SignalPulse API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite for development)
DATABASE_URL=sqlite:///./signalpulse.db

# CORS (frontend dev origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wikipedia adapter (official action API, no key required)
WIKIPEDIA_USER_AGENT=SignalPulse/0.1.0 (https://github.com/signalpulse)
WIKIPEDIA_TIMEOUT_SECONDS=5.0
WIKIPEDIA_LANG=en
WIKIPEDIA_MAX_RESULTS=10

# Guardian Open Platform (get a key at https://open-platform.theguardian.com/)
# Leave empty to run without the source (it will report as unavailable).
GUARDIAN_API_KEY=
GUARDIAN_API_URL=https://content.guardianapis.com/search
GUARDIAN_USER_AGENT=SignalPulse/0.1.0 (https://github.com/signalpulse)
GUARDIAN_TIMEOUT_SECONDS=5.0
GUARDIAN_MAX_RESULTS=10

# Reddit official API (OAuth2 client credentials; app must be registered at
# https://www.reddit.com/prefs/apps). Leave empty to run without the source.
# Requires approval/access before live use; tests run against fixtures.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalPulse/0.1.0 (https://github.com/signalpulse)
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_API_BASE=https://oauth.reddit.com
REDDIT_TIMEOUT_SECONDS=5.0
REDDIT_MAX_RESULTS=10